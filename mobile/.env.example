# Copy to .env for local development (Expo Go / dev client on your LAN).
# Both vars are safe to ship in the built app — EXPO_PUBLIC_* values are inlined
# into the JS bundle, and a Clerk *publishable* key is meant to be public
# (same key the web app hardcodes in client/src/main.jsx).

# Your Express API, reachable from your phone/emulator on the same network.
# Use your machine's LAN IP, not "localhost" (the phone can't resolve that to your PC).
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# From the same Clerk application the web app uses (dashboard.clerk.com > API Keys).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YWJvdmUteWV0aS03MC5jbGVyay5hY2NvdW50cy5kZXYk
