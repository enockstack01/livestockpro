{
  "expo": {
    "name": "LivestockPro",
    "slug": "livestockpro-mobile",
    "version": "1.0.0",
    "scheme": "livestockpro",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.livestockpro.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LivestockPro tags new animal, health, feeding, breeding, production, finance, and task records with your farm's location so admins can spot regional patterns like disease clusters.",
        "NSPhotoLibraryUsageDescription": "LivestockPro needs access to your photos so you can set a profile picture."
      }
    },
    "android": {
      "package": "com.livestockpro.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@clerk/expo",
      "expo-secure-store",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2E7D32"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LivestockPro tags new records with your farm's location so admins can spot regional patterns like disease clusters."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LivestockPro needs access to your photos so you can set a profile picture."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74536205-bab8-49f5-8032-772c94c8ab51"
      }
    },
    "owner": "enockstack"
  }
}
